# Copie para .env (nunca versionar). Em produção (Railway) defina como variáveis do serviço.
# Railway: URL do Postgres (interna no serviço: ${{Postgres.DATABASE_URL}}; local: URL pública do proxy TCP)
DATABASE_URL=postgresql://usuario:senha@host:5432/railway
# true para URL pública/proxy; a rede privada interna do Railway não usa SSL
DB_SSL=true
# Segredo para assinar a sessão (>= 32 caracteres aleatórios)
SESSION_SECRET=
PORT=3000
NODE_ENV=development
# Origem pública do app (usada na checagem de Origin em produção), ex.: https://gestao.seudominio.com.br
APP_ORIGIN=
# Contato oficial da Argos (também gravado na tabela company)
WHATSAPP_CONTACT=5584998590183
# WhatsApp Business Cloud API (Meta) — preencher somente quando a conta for aprovada
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
